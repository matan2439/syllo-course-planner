# ── Step 1 (database) ────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# DIRECT_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Auth (Supabase) ───────────────────────────────────────────────────
# Dashboard → Project Settings → API. PUBLISHABLE (anon) key only — never the
# service-role key. Unset = accounts off; the planner works signed out as before.
# The root api/ functions read the same two variables to verify sessions.
# NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Step 8 (AI — currently served by root api/ until migrated) ───────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
