{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/ai/generate-plan.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai/course-planner.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai/planner-run.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai/apply-plan.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai/edit-board.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai/planning-context.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai/conversation.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/board.ts",
      "use": "@vercel/node"
    },
    {
      "src": "app/web/semester_board_viewer.html",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/board/:programId",
      "destination": "/api/board.ts?programId=:programId"
    },
    {
      "source": "/api/board",
      "destination": "/api/board.ts"
    },
    {
      "source": "/api/ai/generate-plan",
      "destination": "/api/ai/generate-plan.ts"
    },
    {
      "source": "/api/ai/course-planner",
      "destination": "/api/ai/course-planner.ts"
    },
    {
      "source": "/api/ai/planner-run",
      "destination": "/api/ai/planner-run.ts"
    },
    {
      "source": "/api/ai/apply-plan",
      "destination": "/api/ai/apply-plan.ts"
    },
    {
      "source": "/api/ai/edit-board",
      "destination": "/api/ai/edit-board.ts"
    },
    {
      "source": "/api/ai/planning-context",
      "destination": "/api/ai/planning-context.ts"
    },
    {
      "source": "/api/ai/conversation",
      "destination": "/api/ai/conversation.ts"
    },
    {
      "source": "/",
      "destination": "/web"
    },
    {
      "source": "/:path*",
      "destination": "/web/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
