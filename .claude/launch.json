{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 3002
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 3001,
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    },
    {
      "name": "api-alt-port",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "scripts/dev_api_server.ts"],
      "port": 3012,
      "autoPort": false,
      "env": { "DEV_API_PORT": "3012", "AI_DEV_MODE": "true", "AI_DEV_BYPASS_QUOTA": "true", "DATABASE_URL": "", "OPENAI_API_KEY": "" }
    },
    {
      "name": "web-alt-port",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd web && npx next dev --port 3011"],
      "port": 3011,
      "autoPort": false,
      "env": { "PLANNER_API_ORIGIN": "http://localhost:3012", "NODE_OPTIONS": "--max-old-space-size=4096" }
    },
    {
      "name": "api-topic-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/dev_api_server_topic_preview.ts"
      ],
      "port": 3002
    },
    {
      "name": "api-multi-objective-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/dev_api_server_multi_objective_preview.ts"
      ],
      "port": 3002
    },
    {
      "name": "api-alternatives-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/dev_api_server_alternatives_preview.ts"
      ],
      "port": 3002
    }
  ]
}
