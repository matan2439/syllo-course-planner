{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".build",
    "lib": ["ES2020", "DOM"]
  },
  "include": ["api/**/*", "tests/api/**/*"],
  "exclude": ["node_modules", ".build"]
}
