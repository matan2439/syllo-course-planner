# ── AI provider ───────────────────────────────────────────────────────────────
# Selects which provider/model the AI assistant uses. One of: openai | anthropic | google
# If unset, falls back in order: OpenAI -> Anthropic -> Google (first with an API key set).
# OpenAI gpt-4o-mini is the recommended default — low cost, good Hebrew quality.
# AI_PROVIDER=openai

# Set the API key matching your chosen provider (only one is required):

# OpenAI (default): https://platform.openai.com/api-keys — model: gpt-4o-mini
OPENAI_API_KEY=sk-...

# Anthropic: https://console.anthropic.com/settings/keys — model: claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini: https://aistudio.google.com/app/apikey — model: gemini-1.5-flash
# GOOGLE_GENERATIVE_AI_API_KEY=...

# ── AI dev mode ──────────────────────────────────────────────────────────────
# Return a mock AI response without calling Anthropic or OpenAI.
# Ignored automatically when VERCEL_ENV=production.
# Default: false
AI_DEV_MODE=false

# Skip quota DB checks in dev mode — useful when developing without Supabase.
# Ignored when AI_DEV_MODE=false or VERCEL_ENV=production.
# Default: false
AI_DEV_BYPASS_QUOTA=false

# ── AI quota ─────────────────────────────────────────────────────────────────
# Free AI requests per anonymous browser session. Default: 5.
# Set higher for beta testing; set to 0 for no free tier (not recommended).
# AI_FREE_QUOTA=5

# TEMPORARY production testing override — when true, bypasses QUOTA_EXCEEDED
# (HTTP 429) entirely, even if the free quota is exhausted. Usage is still
# tracked normally (credits_used / ai_usage_events). Provider selection and
# payment logic are unaffected.
# Default: false. MUST be set back to false (or removed) before public release.
# AI_TEST_MODE=true

# ── Postgres (Supabase) ───────────────────────────────────────────────────────
# Both URLs are in Supabase dashboard → Settings → Database → Connection string
#
# Pooled connection (port 6543) — used by the app at runtime.
# Leave blank to use local SQLite (default for local dev / tests).
# DATABASE_URL=postgresql://postgres.[ref]:6543/postgres?pgbouncer=true
#
# Direct connection (port 5432) — used ONLY by: alembic upgrade head
# DIRECT_DATABASE_URL=postgresql://postgres.[ref]:5432/postgres
