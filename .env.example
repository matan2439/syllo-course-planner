# ── AI provider — set exactly ONE ────────────────────────────────────────────
# Anthropic (preferred): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI fallback: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# ── AI quota ─────────────────────────────────────────────────────────────────
# Free AI requests per anonymous browser session. Default: 5.
# Set higher for beta testing; set to 0 for no free tier (not recommended).
# AI_FREE_QUOTA=5

# ── Postgres (Supabase) ───────────────────────────────────────────────────────
# Both URLs are in Supabase dashboard → Settings → Database → Connection string
#
# Pooled connection (port 6543) — used by the app at runtime.
# Leave blank to use local SQLite (default for local dev / tests).
# DATABASE_URL=postgresql://postgres.[ref]:6543/postgres?pgbouncer=true
#
# Direct connection (port 5432) — used ONLY by: alembic upgrade head
# DIRECT_DATABASE_URL=postgresql://postgres.[ref]:5432/postgres
